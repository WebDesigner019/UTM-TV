# Kredensial MySQL. Dipakai compose dan saat membuat user database di server.
MYSQL_DATABASE="utm_tv_liputan"
MYSQL_USER="utmtv"
MYSQL_PASSWORD="ganti-dengan-password-database"
MYSQL_ROOT_PASSWORD="ganti-dengan-password-root-yang-kuat"

# Wajib diisi untuk Prisma CLI dan aplikasi kalau jalan di luar Compose.
# Compose merakit sendiri dari MYSQL_USER/MYSQL_PASSWORD di atas.
DATABASE_URL="mysql://utmtv:password-database@localhost:3306/utm_tv_liputan"

# Rahasia aplikasi. Buat dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"

# Hanya dipakai sebagai cadangan kalau JWT_SECRET kosong. Tidak wajib diisi.
SESSION_SECRET=""

# Akun admin awal, hanya dipakai saat seed.
ADMIN_SEED_EMAIL="admin@trunojoyo.ac.id"
ADMIN_SEED_PASSWORD="ganti-dengan-password-admin-yang-aman"
ADMIN_SEED_NAME="Admin COMPACT"

# Hanya dipakai Compose untuk memetakan port ke host. Di luar Compose, atur
# port lewat Environment=PORT= di service systemd.
APP_PORT="3000"
APP_BIND="0.0.0.0"

# Jumlah proxy yang menyisipkan header X-Forwarded-For. Rate limit memakai
# alamat dari header ini untuk mengenali pengunjung.
#   0 = tidak ada proxy, aplikasi diekspos langsung (nilai bawaan)
#   1 = ada satu proxy di depan aplikasi, mis. nginx atau Caddy
# Jangan diisi lebih dari jumlah proxy sebenarnya, karena nilai yang kelewat
# besar membuat penyerang memakai IP palsu dan melewati rate limit.
TRUSTED_PROXY_HOPS="0"

# URL publik aplikasi. Dipakai untuk tautan lacak dan reset password, jadi
# di produksi harus domain https yang sebenarnya, tanpa garis miring akhir.
APP_URL="http://localhost:3000"

# Direktori upload. Path relatif ikut ke folder kerja aplikasi, jadi lebih aman
# pakai path absolut supaya tidak berubah kalau aplikasi dijalankan dari folder
# lain. Compose meng-override nilai ini ke /app/uploads.
UPLOAD_DIR="/srv/utm-tv/uploads"
MAX_FILE_SIZE_MB="10"
ALLOWED_EMAIL_DOMAINS="student.trunojoyo.ac.id,trunojoyo.ac.id"

# SMTP opsional. Kalau kosong, email tetap jalan dan dicetak ke log.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@trunojoyo.ac.id"

# Notifikasi WhatsApp lewat Fonnte, opsional.
FONNTE_WA_API=""
FONNTE_GROUP_ID=""
