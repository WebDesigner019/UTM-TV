generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusPermohonan {
  diterima
  disetujui
  ditolak
  selesai
}

enum JenisPermohonan {
  liputan
  media_partner
  kerjasama
  peminjaman_podcast
}

model Admin {
  id                    Int                         @id @default(autoincrement())
  nama                  String
  email                 String                      @unique
  passwordHash          String                      @map("password_hash")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  historiesLiputan          StatusHistoryLiputan[]
  historiesMediaPartner     StatusHistoryMediaPartner[]
  historiesKerjasama        StatusHistoryKerjasama[]
  historiesPeminjamanPodcast StatusHistoryPeminjamanPodcast[]
  passwordResetTokens       AdminPasswordResetToken[]

  @@map("admins")
}

model AdminPasswordResetToken {
  id        Int       @id @default(autoincrement())
  adminId   Int       @map("admin_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_password_reset_tokens")
}

model PermohonanLiputan {
  id                   Int                    @id @default(autoincrement())
  nomorRujukan         String                 @unique @map("nomor_rujukan") @db.VarChar(32)
  namaInstansi         String                 @map("nama_instansi")
  email                String?
  noWa                 String?                @map("no_wa")
  namaAcara            String                 @map("nama_acara")
  tanggalAcara         DateTime               @map("tanggal_acara") @db.Date
  tempatAcara          String                 @map("tempat_acara")
  detailPesertaAudiens String?                @map("detail_peserta_audiens") @db.Text
  filePath             String?                @map("file_path")
  fileOriginalName     String?                @map("file_original_name")
  fileMimeType         String?                @map("file_mime_type")
  fileSizeBytes        Int?                   @map("file_size_bytes")
  status               StatusPermohonan       @default(diterima)
  pesanPemohon         String?                @map("pesan_pemohon") @db.Text
  catatanInternal      String?                @map("catatan_internal") @db.Text
  inputManuallyEntered Boolean                 @default(false) @map("input_manually_entered")
  tokenLacak           String?                @unique @map("token_lacak")
  tokenLacakExpiresAt  DateTime?              @map("token_lacak_expires_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  statusHistory        StatusHistoryLiputan[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("permohonan_liputan")
}

model StatusHistoryLiputan {
  id               Int               @id @default(autoincrement())
  permohonanId     Int               @map("permohonan_id")
  statusLama       StatusPermohonan? @map("status_lama")
  statusBaru       StatusPermohonan  @map("status_baru")
  pesan            String?           @db.Text
  changedByAdminId Int?              @map("changed_by_admin_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  permohonan       PermohonanLiputan @relation(fields: [permohonanId], references: [id], onDelete: Cascade)
  admin            Admin?            @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([permohonanId])
  @@index([changedByAdminId])
  @@map("status_history_liputan")
}

model PermohonanMediaPartner {
  id                    Int                         @id @default(autoincrement())
  nomorRujukan          String                      @unique @map("nomor_rujukan") @db.VarChar(32)
  fakultasOrganisasi    String                      @map("fakultas_organisasi")
  email                 String?
  namaAcara             String                      @map("nama_acara")
  tanggalRequestUpload  DateTime                    @map("tanggal_request_upload") @db.Date
  kontakPenanggungJawab String                      @map("kontak_penanggung_jawab")
  filePath              String?                     @map("file_path")
  fileOriginalName      String?                     @map("file_original_name")
  fileMimeType          String?                     @map("file_mime_type")
  fileSizeBytes         Int?                        @map("file_size_bytes")
  status                StatusPermohonan            @default(diterima)
  pesanPemohon          String?                     @map("pesan_pemohon") @db.Text
  catatanInternal       String?                     @map("catatan_internal") @db.Text
  inputManuallyEntered  Boolean                     @default(false) @map("input_manually_entered")
  tokenLacak            String?                     @unique @map("token_lacak")
  tokenLacakExpiresAt   DateTime?                   @map("token_lacak_expires_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  statusHistory         StatusHistoryMediaPartner[]

  @@index([status])
  @@index([createdAt])
  @@map("permohonan_media_partner")
}

model StatusHistoryMediaPartner {
  id               Int                    @id @default(autoincrement())
  permohonanId     Int                    @map("permohonan_id")
  statusLama       StatusPermohonan?      @map("status_lama")
  statusBaru       StatusPermohonan       @map("status_baru")
  pesan            String?                @db.Text
  changedByAdminId Int?                   @map("changed_by_admin_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  permohonan       PermohonanMediaPartner @relation(fields: [permohonanId], references: [id], onDelete: Cascade)
  admin            Admin?                 @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([permohonanId])
  @@index([changedByAdminId])
  @@map("status_history_media_partner")
}

model PermohonanKerjasama {
  id                    Int                      @id @default(autoincrement())
  nomorRujukan          String                   @unique @map("nomor_rujukan") @db.VarChar(32)
  fakultasOrganisasi    String                   @map("fakultas_organisasi")
  email                 String?
  namaAcara             String                   @map("nama_acara")
  tanggalRequestUpload  DateTime?                @map("tanggal_request_upload") @db.Date
  kontakPenanggungJawab String                   @map("kontak_penanggung_jawab")
  filePath              String?                   @map("file_path")
  fileOriginalName      String?                   @map("file_original_name")
  fileMimeType          String?                   @map("file_mime_type")
  fileSizeBytes         Int?                      @map("file_size_bytes")
  status                StatusPermohonan         @default(diterima)
  pesanPemohon          String?                  @map("pesan_pemohon") @db.Text
  catatanInternal       String?                  @map("catatan_internal") @db.Text
  inputManuallyEntered  Boolean                  @default(false) @map("input_manually_entered")
  tokenLacak            String?                  @unique @map("token_lacak")
  tokenLacakExpiresAt   DateTime?                @map("token_lacak_expires_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  statusHistory         StatusHistoryKerjasama[]

  @@index([status])
  @@index([createdAt])
  @@map("permohonan_kerjasama")
}

model StatusHistoryKerjasama {
  id               Int                 @id @default(autoincrement())
  permohonanId     Int                 @map("permohonan_id")
  statusLama       StatusPermohonan?   @map("status_lama")
  statusBaru       StatusPermohonan    @map("status_baru")
  pesan            String?             @db.Text
  changedByAdminId Int?                @map("changed_by_admin_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  permohonan       PermohonanKerjasama @relation(fields: [permohonanId], references: [id], onDelete: Cascade)
  admin            Admin?              @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([permohonanId])
  @@index([changedByAdminId])
  @@map("status_history_kerjasama")
}

model PermohonanPeminjamanPodcast {
  id                           Int                          @id @default(autoincrement())
  nomorRujukan                 String                       @unique @map("nomor_rujukan") @db.VarChar(32)
  namaInstansi                 String                       @map("nama_instansi")
  namaAcara                    String                       @map("nama_acara")
  tanggalPeminjaman            DateTime                     @map("tanggal_peminjaman") @db.Date
  waktuMulai                   String                       @map("waktu_mulai") @db.VarChar(5)
  waktuSelesai                 String                       @map("waktu_selesai") @db.VarChar(5)
  kontakPenanggungJawab        String                       @map("kontak_penanggung_jawab")
  noteDetail                   String                       @map("note_detail") @db.Text
  email                        String?
  fileRekomBakkPath            String?                      @map("file_rekom_bakk_path")
  fileRekomBakkOriginalName    String?                      @map("file_rekom_bakk_original_name")
  fileRekomBakkMimeType        String?                      @map("file_rekom_bakk_mime_type")
  fileRekomBakkSizeBytes       Int?                         @map("file_rekom_bakk_size_bytes")
  filePernyataanPath           String?                      @map("file_pernyataan_path")
  filePernyataanOriginalName   String?                      @map("file_pernyataan_original_name")
  filePernyataanMimeType       String?                      @map("file_pernyataan_mime_type")
  filePernyataanSizeBytes      Int?                         @map("file_pernyataan_size_bytes")
  status                       StatusPermohonan             @default(diterima)
  pesanPemohon                 String?                      @map("pesan_pemohon") @db.Text
  catatanInternal              String?                      @map("catatan_internal") @db.Text
  inputManuallyEntered         Boolean                      @default(false) @map("input_manually_entered")
  tokenLacak                   String?                      @unique @map("token_lacak")
  tokenLacakExpiresAt          DateTime?                    @map("token_lacak_expires_at")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  statusHistory                StatusHistoryPeminjamanPodcast[]

  @@index([status])
  @@index([createdAt])
  @@map("permohonan_peminjaman_podcast")
}

model StatusHistoryPeminjamanPodcast {
  id               Int                        @id @default(autoincrement())
  permohonanId     Int                        @map("permohonan_id")
  statusLama       StatusPermohonan?          @map("status_lama")
  statusBaru       StatusPermohonan           @map("status_baru")
  pesan            String?                    @db.Text
  changedByAdminId Int?                       @map("changed_by_admin_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  permohonan       PermohonanPeminjamanPodcast @relation(fields: [permohonanId], references: [id], onDelete: Cascade)
  admin            Admin?                     @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([permohonanId])
  @@index([changedByAdminId])
  @@map("status_history_peminjaman_podcast")
}

model Pengaturan {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pengaturan")
}
